# ============================================
# EVIKO POS - Backend .env (cPanel uchun)
# ============================================
# Bu faylni .env nomida serverda yarating!

# cPanel PostgreSQL ulanish (o'zingiznikiga almashtiring)
DATABASE_URL=postgresql+asyncpg://evikouz_USERNAME:PASSWORD@127.0.0.1:5432/evikouz_DBNAME

# JWT Secret - kamida 32 ta belgi
JWT_SECRET=your-super-secret-key-minimum-32-chars

# JWT sozlamalari
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
